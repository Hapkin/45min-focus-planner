#main sturcture
#just 3 rows with min info: menu;body;Bottom

<main_kv@GridLayout>:
    rows: 3
    canvas.before:
        Color:
            rgba: (20/255),(80/255),(20/255),0.5
        Rectangle:
			pos: self.pos
			size: self.size


    Menu:
        size_hint_y: 0.15
        height: "30dp"  

    Body:
        size_hint_y: 1
        height: self.parent.height - self.parent.children[0].height - self.parent.children[1].height  
        # Calculate height based on parent

    Bottom: 
        size_hint_y: 0.10
        height: "20dp"  


